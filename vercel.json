{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/insights.js": {
      "includeFiles": "templates/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/insights",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/insights/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/api/insights",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/demo-pulse",
      "destination": "https://pulse-sc-c201.vercel.app/demo-pulse"
    },
    {
      "source": "/demo-pulse/:path*",
      "destination": "https://pulse-sc-c201.vercel.app/demo-pulse/:path*"
    }
  ]
}
